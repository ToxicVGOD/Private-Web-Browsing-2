{
  "name": "Cloud Browser",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y google-chrome-stable",
  "containerEnv": {
    "CHROME_USER_DATA_DIR": "/workspaces/.codespaces/shared/chrome-profile"
  }
}
